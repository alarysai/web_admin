rules_version = '2';

// Ponto de partida fechado: nenhum acesso direto pelo SDK cliente.
// O web admin acessa via Admin SDK (servidor), que ignora estas regras.
// Abra coleções específicas aqui quando os apps precisarem ler/escrever.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
