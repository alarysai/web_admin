# Copie para .env.local (local) e cadastre as mesmas chaves na Vercel
# (Project Settings → Environment Variables).

# --- Firebase Web SDK (público, vai para o navegador) ---
# Valores: `firebase apps:sdkconfig WEB --project alarysai-b6e85`
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=alarysai-b6e85.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=alarysai-b6e85
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=alarysai-b6e85.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SECRETO, só servidor) ---
# Console → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_PROJECT_ID=alarysai-b6e85
FIREBASE_CLIENT_EMAIL=
# Cole entre aspas, com \n no lugar das quebras de linha
FIREBASE_PRIVATE_KEY=
